# PaperMoon runs with ZERO env vars — everything below is optional.

# Public URL of the app (used for metadata). Defaults to http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force the synthetic demo feed even when Binance is reachable.
# Set to "true" to always use simulated prices (useful for offline demos / restricted networks).
# When unset, the app auto-detects: real Binance data if reachable, synthetic feed otherwise.
NEXT_PUBLIC_DEMO_MODE=

# Base URLs for Binance (override for regional endpoints, e.g. Binance.US).
# Defaults: https://api.binance.com  /  wss://stream.binance.com:9443
NEXT_PUBLIC_BINANCE_REST_URL=
NEXT_PUBLIC_BINANCE_WS_URL=

# ---------------------------------------------------------------------------
# The full production blueprint (Supabase auth+DB, limit-order cron, deploy)
# lives in ../output/papermoon-blueprint.md. Those vars are NOT needed to run
# this local MVP — the portfolio is persisted in the browser (localStorage).
# ---------------------------------------------------------------------------
